APP_ENV=development
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

DB_DSN=osivote:change_me@tcp(127.0.0.1:3306)/go_voting?parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27
AUTO_MIGRATE=true

TOKEN_SECRET=replace_with_64_hex_characters
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_TTL=12h

SCHOOL_NAME=Nama Sekolah Anda
SCHOOL_SLUG=nama-sekolah
SCHOOL_EMAIL=email@sekolah.sch.id
SCHOOL_ADDRESS=Alamat sekolah
SCHOOL_PHONE=Nomor telepon
SCHOOL_WEBSITE=https://sekolah.sch.id

ADMIN_NAME=Panitia OSIS
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sekolah.sch.id
ADMIN_PASSWORD=replace_with_a_long_unique_password

SEED_DEMO=false
UPLOAD_DIR=./storage/uploads
