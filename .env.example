# Application
APP_ENV=development
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

# MySQL. Create the database first; migrations run automatically when AUTO_MIGRATE=true.
DB_DSN=osivote:change_me@tcp(127.0.0.1:3306)/go_voting?parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27
AUTO_MIGRATE=true

# Generate with: openssl rand -hex 32
TOKEN_SECRET=replace_with_64_hex_characters
# Set to true behind HTTPS. Never leave false in production.
COOKIE_SECURE=false
# Set true only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false
# Admin session lifetime, for example 12h or 30m.
SESSION_TTL=12h

# Initial school identity (used only when the database is empty).
SCHOOL_NAME=Nama Sekolah Anda
SCHOOL_SLUG=nama-sekolah
SCHOOL_EMAIL=email@sekolah.sch.id
SCHOOL_ADDRESS=Alamat sekolah
SCHOOL_PHONE=Nomor telepon
SCHOOL_WEBSITE=https://sekolah.sch.id

# Initial administrator (created only when no admin exists).
ADMIN_NAME=Panitia OSIS
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sekolah.sch.id
ADMIN_PASSWORD=replace_with_a_long_unique_password

# Demo election + candidates. Turn OFF in production.
SEED_DEMO=false
UPLOAD_DIR=./storage/uploads
